PORT=5000
# Change this before deploying the admin panel.
ADMIN_PASSWORD=replace-with-a-strong-password
# Required: Google Drive is the single source of truth for website content and images.
GOOGLE_DRIVE_FOLDER_ID=1a9KJLM9IL2cb-3xMFAjuOmZnZQf0dM_0
# Recommended for a personal, free Google Drive account: OAuth desktop client values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Service accounts only work when using a Google Shared Drive, not a personal Drive folder.
# Paste the service-account JSON here, or give an absolute path to its JSON key-file.
GOOGLE_SERVICE_ACCOUNT_JSON=
